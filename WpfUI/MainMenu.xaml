<Window x:Class="WpfUI.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        xmlns:vm="clr-namespace:WpfUI.ViewModels"
        xmlns:controls="clr-namespace:WpfUI.Controls"
        mc:Ignorable="d"
        Title="UITestKit Main Menu" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <DockPanel>

        <Menu DockPanel.Dock="Top" Background="WhiteSmoke" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Padding="10,5">
                <MenuItem Header="_New Test Case..." Click="BtnCreateTestCase_Click"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="BtnExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools" Padding="10,5">
                <MenuItem Header="Reset DB" ToolTip="Reset database connection (chưa có logic)"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="10">
            <WrapPanel Orientation="Horizontal">

                

                <Separator Width="1" Background="#526D8B" Margin="5,0"/>

                <Button Content="🔄 Reset DB" 
                        ToolTip="Reset DB" 
                        Padding="8,4" Margin="0,0,5,0"
                        Background="#E74C3C" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        FontWeight="SemiBold"/>

                <TextBlock Text="|" Foreground="#526D8B" VerticalAlignment="Center" Margin="5,0"/>

                

                

            </WrapPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <GroupBox Header="📁 Test Case Explorer" Margin="5,0,5,5" FontWeight="Bold" Background="White" BorderBrush="#CCC">
                    <TreeView x:Name="FileTree" 
                              ItemsSource="{Binding RootItems}"
                              SelectedItemChanged="FileTree_SelectedItemChanged"
                              Margin="5" Background="Transparent" BorderThickness="0">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="5,3"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3898FA"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#3898FA"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FileSystemItemViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IsFolder, Converter={StaticResource FolderToIconConverter}}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDD" ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="2">
                <Border Margin="0,5,5,5" Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3">
                    <ContentControl x:Name="MainContentArea" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="250"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                
                            </StackPanel>

                            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="LightGray" ResizeBehavior="PreviousAndNext"/>

                            <controls:LogViewerControl Grid.Row="2" />

                        </Grid>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>

    </DockPanel>
</Window>