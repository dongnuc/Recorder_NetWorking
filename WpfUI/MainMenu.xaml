<Window x:Class="WpfUI.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        xmlns:vm="clr-namespace:WpfUI.ViewModels"
        xmlns:controls="clr-namespace:WpfUI.Controls"
        mc:Ignorable="d"
        Title="UITestKit Main Menu" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Window.Resources>
        <ContextMenu x:Key="TreeViewItemContextMenu">
            <MenuItem Tag="CreateQuestion"
                      Header="Create Question..."
                      Click="CmCreateQuestion_Click"
                      FontWeight="Bold"
                      Visibility="Collapsed"/>
            <MenuItem Tag="DeleteQuestion"
                      Header="Delete Question"
                      Click="CmDelete_Click"
                      Visibility="Collapsed"/>
            <Separator Tag="Sep1" Visibility="Collapsed"/>
            <MenuItem Tag="CreateTestCase"
                      Header="Create TestCase..."
                      Click="CmCreateTestCase_Click"
                      FontWeight="Bold"
                      Visibility="Collapsed"/>
            <MenuItem Tag="DeleteTestCase"
                      Header="Delete TestCase"
                      Click="CmDelete_Click"
                      Visibility="Collapsed"/>
        </ContextMenu>

        <Style x:Key="TreeViewToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16" SnapsToDevicePixels="True">
                            <Path x:Name="Arrow" 
                                  Stroke="#606060" 
                                  StrokeThickness="1.5"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Data="M 5 3 L 10 8 L 5 13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 3 5 L 8 10 L 13 5" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Stroke" Value="#0078D7"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter TargetName="Arrow" Property="Stroke" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="WhiteSmoke" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Padding="10,5">
                <MenuItem Header="_New Test Case..." Click="BtnCreateTestCase_Click"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="BtnExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools" Padding="10,5">
                <MenuItem Header="Reset DB" ToolTip="Reset database connection (chưa có logic)"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="10">
            <WrapPanel Orientation="Horizontal">
                <Separator Width="1" Background="#526D8B" Margin="5,0"/>
                <Button Content="⚙️ Config" 
                    ToolTip="Cấu hình Executables và Protocol" 
                    Padding="8,4" Margin="0,0,5,0"
                    Background="#3498DB" 
                    Foreground="White" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    FontWeight="SemiBold"
                    Click="BtnConfig_Click"/>

                <TextBlock Text="|" Foreground="#526D8B" VerticalAlignment="Center" Margin="5,0"/>
                <Button Content="🔄 Reset DB" 
                        ToolTip="Reset DB" 
                        Padding="8,4" Margin="0,0,5,0"
                        Background="#E74C3C" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Click="BtnResetDb_Click"/>
                <TextBlock Text="|" Foreground="#526D8B" VerticalAlignment="Center" Margin="5,0"/>
            </WrapPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="250" MinHeight="100"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="250"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <GroupBox Header="📁 Test Case Explorer" Margin="5" FontWeight="Bold">
                        <TreeView x:Name="FileTree" 
                                  ItemsSource="{Binding RootItems}"
                                  SelectedItemChanged="FileTree_SelectedItemChanged"
                                  Margin="5">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate 
                                    DataType="{x:Type vm:FileSystemItemViewModel}" 
                                    ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IsFolder, Converter={StaticResource FolderToIconConverter}}" 
                                                   FontFamily="Segoe MDL2 Assets" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,5,0"
                                                   FontSize="14"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </GroupBox>
                </Grid>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray" ResizeBehavior="PreviousAndNext"/>

                <Grid Grid.Column="2">
                    <TabControl x:Name="TestCaseTabControl" 
                                Margin="5"
                                SelectionChanged="TestCaseTabControl_SelectionChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,10,0"/>
                                                <Button Content="✕" 
                                                        FontSize="12"
                                                        Width="20" 
                                                        Height="20"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="Gray"
                                                        Cursor="Hand"
                                                        ToolTip="Close tab"
                                                        Click="CloseTab_Click"
                                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="🏠 Welcome" x:Name="WelcomeTab">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Chào mừng! Vui lòng chọn một file từ cây bên trái."
                                           FontSize="18" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" Foreground="Gray"/>
                                <TextBlock Text="Hoặc tạo Test Case mới từ menu File."
                                           FontSize="14" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" Foreground="DarkGray" Margin="0,10,0,0"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <!-- GridSplitter cho Log Panel -->
            <GridSplitter Grid.Row="1" 
                          Height="5" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch" 
                          Background="LightGray" 
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Log Viewer Panel - Always Visible -->
            <Border Grid.Row="2" 
                    BorderBrush="LightGray" 
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#FF2D2D30" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBlock Text="Application Logs" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       VerticalAlignment="Center"
                                       FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Log Content -->
                    <controls:LogViewerControl Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>

    </DockPanel>
</Window>