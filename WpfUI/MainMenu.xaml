<Window x:Class="WpfUI.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        xmlns:vm="clr-namespace:WpfUI.ViewModels"
        mc:Ignorable="d"
        Title="UITestKit Main Menu" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Test Case..." Click="BtnCreateTestCase_Click"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="BtnExit_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <GroupBox Header="📁 Test Case Explorer" Margin="5" FontWeight="Bold">
                    <TreeView x:Name="FileTree" 
                              ItemsSource="{Binding RootItems}"
                              SelectedItemChanged="FileTree_SelectedItemChanged"
                              Margin="5">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate 
                                DataType="{x:Type vm:FileSystemItemViewModel}" 
                                ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IsFolder, Converter={StaticResource FolderToIconConverter}}" 
                                               FontFamily="Segoe MDL2 Assets" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,5,0"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray" ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="2">
                <ContentControl x:Name="MainContentArea" Margin="5">
                    <TextBlock Text="Chào mừng! Vui lòng chọn một file từ cây bên trái."
                               FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="Gray"/>
                </ContentControl>
            </Grid>
        </Grid>

    </DockPanel>
</Window>