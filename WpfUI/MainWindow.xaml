<Window x:Class="WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UITestKit - Test Case Recorder" 
        Height="850" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="🎙️ Test Case Recorder Setup"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <GroupBox Grid.Row="1" Header="Client Executable" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtClientPath" 
                         Grid.Column="0"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         ToolTip="Path to client executable"/>

                <Button Grid.Column="1"
                        Content="📁 Browse"
                        Width="100"
                        Height="30"
                        Click="BtnBrowseClient_Click"
                        Background="#3498DB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Server Executable" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtServerPath" 
                         Grid.Column="0"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         ToolTip="Path to server executable"/>

                <Button Grid.Column="1"
                        Content="📁 Browse"
                        Width="100"
                        Height="30"
                        Click="BtnBrowseServer_Click"
                        Background="#3498DB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Test Case Name" Margin="0,0,0,10">
            <TextBox x:Name="TxtTestCaseName" 
                     Height="30"
                     VerticalContentAlignment="Center"
                     Text="TestCase_001"
                     ToolTip="Enter test case name"/>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Protocol" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbHttp" 
                             Content="🌐 HTTP" 
                             IsChecked="True"
                             Margin="10,0,20,0"
                             VerticalAlignment="Center"/>
                <RadioButton x:Name="RbTcp" 
                             Content="🔌 TCP"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="5" 
                Background="#34495E" 
                Padding="10"
                CornerRadius="5"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TxtStatus" 
                           Text="Ready to start recording"
                           Foreground="White"
                           FontWeight="Bold"/>
                <TextBlock x:Name="TxtPortInfo" 
                           Text=""
                           Foreground="#BDC3C7"
                           FontSize="11"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="6"
                x:Name="BtnStartRecording"
                Content="🎙️ Start Recording"
                Height="50"
                FontSize="16"
                FontWeight="Bold"
                Background="#27AE60"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnStartRecording_Click"
                VerticalAlignment="Top">
            <Button.Effect>
                <DropShadowEffect Color="#27AE60" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
            </Button.Effect>
        </Button>
    </Grid>
</Window>