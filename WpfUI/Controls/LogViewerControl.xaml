<!-- WpfUI/Controls/LogViewerControl.xaml -->
<UserControl x:Class="WpfUI.Controls.LogViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <WrapPanel Orientation="Horizontal">
                <Button Content="🗑️ Clear" 
                        Padding="8,4" 
                        Margin="0,0,5,0"
                        Background="#E74C3C"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Clear all logs"
                        Click="BtnClearLogs_Click"/>

                <ComboBox x:Name="CmbLogLevel" 
                          Width="120" 
                          Margin="0,0,5,0"
                          ToolTip="Filter by log level"
                          SelectionChanged="CmbLogLevel_SelectionChanged">
                    <ComboBoxItem Content="🔍 All" IsSelected="True"/>
                    <ComboBoxItem Content="🐛 Debug" Tag="Debug"/>
                    <ComboBoxItem Content="ℹ️ Info" Tag="Information"/>
                    <ComboBoxItem Content="⚠️ Warning" Tag="Warning"/>
                    <ComboBoxItem Content="❌ Error" Tag="Error"/>
                    <ComboBoxItem Content="🔥 Critical" Tag="Critical"/>
                </ComboBox>

                <TextBox x:Name="TxtSearch" 
                         Width="150" 
                         Margin="0,0,5,0"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"
                         ToolTip="Search logs"/>

                <CheckBox x:Name="ChkAutoScroll" 
                          Content="📜 Auto" 
                          IsChecked="True" 
                          Foreground="White"
                          VerticalAlignment="Center"
                          ToolTip="Auto scroll to bottom"
                          Margin="0,0,5,0"/>

                <Button Content="📁 File"
                        Padding="8,4"
                        Margin="0,0,5,0"
                        Background="#3498DB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Open log file"
                        Click="BtnOpenLogFile_Click"/>

                <TextBlock x:Name="TxtLogCount"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="5,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Log ListView -->
        <ListView x:Name="LstLogs" 
                  Grid.Row="1"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  BorderThickness="0"
                  AlternationCount="2">

            <!-- Alternating row colors -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E8F4F8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="⏰ Time" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedTimestamp}" 
                                           FontFamily="Consolas"
                                           FontSize="10"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="📊 Level" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding LevelBrush}" 
                                        CornerRadius="3" 
                                        Padding="6,2">
                                    <TextBlock Text="{Binding LevelText}" 
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="9"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="🔧 Source" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Source}" 
                                           FontFamily="Consolas"
                                           FontSize="9"
                                           ToolTip="{Binding Source}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="💬 Message" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" 
                                           TextWrapping="Wrap"
                                           Margin="5,2"
                                           ToolTip="{Binding Message}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" 
                           Text="Ready" 
                           Foreground="White"
                           FontSize="10"
                           DockPanel.Dock="Left"/>

                <TextBlock x:Name="TxtLogFilePath"
                           Text=""
                           Foreground="#95A5A6"
                           FontSize="9"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>