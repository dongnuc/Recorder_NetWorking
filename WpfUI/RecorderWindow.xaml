<Window x:Class="WpfUI.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        mc:Ignorable="d"
        Title="RecorderWindow" Height="700" Width="1200"
        Closing="Window_Closing">
    <Grid>
        <DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                <Border Background="#2C3E50" 
                        Padding="10,5" 
                        CornerRadius="3"
                        Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦 Queue: " 
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding PendingTransactionCount}" 
                                   Foreground="#3498DB"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   MinWidth="20"
                                   TextAlignment="Center"/>

                        <TextBlock Text="⚠️" 
                                   Foreground="Yellow"
                                   FontSize="12"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   ToolTip="Press F12 to capture input and flush queue">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingTransactionCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Content="📥 Save Data" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnExportData_Click"
                        Background="#27AE60" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Export all test data to Excel file"/>

                <Separator Width="2" Background="LightGray" Margin="10,0"/>

                <Button x:Name="BtnStartClient"
                        Content="▶️ Start Client" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnStartClient_Click"
                        Background="#3498DB" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Start the client process"
                        Visibility="Visible"/>

                <Button x:Name="BtnCloseClient"
                        Content="🔴 Close Client" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnCloseClient_Click"
                        Background="#E67E22" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Stop and close the client process"
                        Visibility="Collapsed"/>

                <Button x:Name="BtnStartServer"
                        Content="▶️ Start Server" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnStartServer_Click"
                        Background="#9B59B6" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Start the server process"
                        Visibility="Visible"/>

                <Button x:Name="BtnCloseServer"
                        Content="🔴 Close Server" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnCloseServer_Click"
                        Background="#9B59B6" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Stop and close the server process"
                        Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                <Label Content="Select Stage:" Margin="5,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox x:Name="cmbStages"
                          ItemsSource="{Binding StageKeys}"
                          SelectedValue="{Binding SelectedStageKey, Mode=TwoWay}"
                          SelectionChanged="CmbStages_SelectionChanged"
                          Width="200"
                          VerticalAlignment="Center"
                          FontSize="12"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray">
                    <Run Text="Total Stages: "/>
                    <Run Text="{Binding StageKeys.Count, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <Button Content="🗑️ Delete Stage" 
                        Width="120" 
                        Margin="20,0,0,0" 
                        Click="BtnDeleteStage_Click"
                        Background="#E74C3C" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        VerticalAlignment="Center"
                        ToolTip="Delete the selected stage and all its data"/>
            </StackPanel>

            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="👤 User Input">
                    <Grid Margin="5,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="Stage:" FontWeight="Bold" VerticalAlignment="Center" Padding="0"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SelectedStageData.User.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="3,0"
                                 VerticalAlignment="Center"
                                 Height="24"/>

                        <Label Grid.Column="2" Content="Action:" FontWeight="Bold" VerticalAlignment="Center" Padding="0" Margin="8,0,0,0"/>
                        <TextBox Grid.Column="3" 
                                 Text="{Binding SelectedStageData.User.Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="3,0"
                                 VerticalAlignment="Center"
                                 Height="24"/>

                        <Label Grid.Column="4" Content="Input:" FontWeight="Bold" VerticalAlignment="Center" Padding="0" Margin="8,0,0,0"/>
                        <TextBox Grid.Column="5" 
                                 Text="{Binding SelectedStageData.User.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="3,0"
                                 VerticalAlignment="Center"
                                 Height="24"/>

                        <Button Grid.Column="6" 
                                Content="🧹" 
                                Click="BtnClearInputClient_Click"
                                Background="#E67E22" 
                                Foreground="White"
                                BorderThickness="0" 
                                Cursor="Hand"
                                Padding="6,2"
                                Margin="3,0"
                                Width="35"
                                Height="24"
                                VerticalAlignment="Center"
                                ToolTip="Clear user input data"/>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" 
                              Height="5" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Center"
                              Background="LightGray"
                              ShowsPreview="True"/>

                <GroupBox Grid.Row="2" Header="📊 Outputs" Margin="0,5,0,0">
                    <TabControl>
                        <TabItem Header="💻 Client">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                                        <Button Content="🧹 Clear Data" 
                                                Click="BtnClearOutputClient_Click"
                                                Background="#E67E22" 
                                                Foreground="White"
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                Padding="8,4"
                                                ToolTip="Clear client output data for current stage"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" Content="Stage:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Client.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="Console:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Client.Console, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"
                                                 MinHeight="350"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="🖥️ Server">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                                        <Button Content="🧹 Clear Data" 
                                                Click="BtnClearOutputServer_Click"
                                                Background="#E67E22" 
                                                Foreground="White"
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                Padding="8,4"
                                                ToolTip="Clear server output data for current stage"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" Content="Stage:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Server.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="Console:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Server.Console, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"
                                                 MinHeight="350"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="🗄️ Database">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                                        <Button Content="🧹 Clear Data" 
                                                Click="BtnClearOutputDB_Click"
                                                Background="#E67E22" 
                                                Foreground="White"
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                Padding="8,4"
                                                ToolTip="Clear database data for current stage"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" Content="Stage:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Database.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="Query:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Database.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"
                                                 MinHeight="140"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"/>

                                        <Label Grid.Row="2" Grid.Column="0" Content="Expected Data:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Database.ExpectedData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"
                                                 MinHeight="230"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="🌐 Network List">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F8F9FA" Padding="8,5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="Protocol View:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2C3E50"/>
                                            <ComboBox x:Name="cmbNetworkType" Width="160" SelectedIndex="0" VerticalAlignment="Center" >
                                                <ComboBoxItem Content="🔌 TCP Traffic"/>
                                                <ComboBoxItem Content="🌐 HTTP Traffic"/>
                                            </ComboBox>

                                            <TextBlock Margin="20,0,0,0" VerticalAlignment="Center">
                <Run Text="Queue Buffer: " FontWeight="Bold" Foreground="#7F8C8D"/>
                <Run Text="{Binding PendingTransactionCount}" FontWeight="Bold" Foreground="#E74C3C"/>
                                            </TextBlock>

                                            <Button Content="⬇️ Flush Queue" 
                    Margin="10,0,0,0"
                    Padding="10,5"
                    Background="#3498DB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnFlushNetwork_Click"
                    ToolTip="Push buffered network data to the list"/>
                                        </StackPanel>

                                        <Button DockPanel.Dock="Right" 
                        Content="🧹 Clear Logs" 
                        Click="BtnClearNetwork_Click"
                        HorizontalAlignment="Right"
                        Background="#E74C3C" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="10,5"
                        FontWeight="SemiBold"
                        ToolTip="Clear all captured network logs"/>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1">

                                    <Grid x:Name="GridTcpView">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbNetworkType}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <DataGrid x:Name="dgTcp"
              Grid.Row="0"
              ItemsSource="{Binding SelectedStageData.NetworkTcpFlows}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True"
              SelectionMode="Extended"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              Background="White"
              RowHeight="25"
              BorderThickness="0">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="❌ Delete Selected Row" Click="BtnDeleteTcpRow_Click"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                                                <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="150"/>
                                                <DataGridTextColumn Header="Source IP:Port" Binding="{Binding Source}" Width="140" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Src Role" Binding="{Binding SourceRole}" Width="80" Foreground="Gray"/>
                                                <DataGridTextColumn Header="Dest IP:Port" Binding="{Binding Destination}" Width="140" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Dst Role" Binding="{Binding DestinationRole}" Width="80" Foreground="Gray"/>
                                                <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="80" FontWeight="Bold" Foreground="#E67E22"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>

                                                <DataGridTextColumn Header="Preview Data" Binding="{Binding Data}" Width="*" Foreground="#34495E">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                            <Setter Property="ToolTip" Value="{Binding Data}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#BDC3C7" ShowsPreview="True"/>

                                        <GroupBox Grid.Row="2" Header="📦 TCP Payload Data (Detail View)" Margin="5" BorderBrush="#3498DB">
                                            <TextBox x:Name="txtTcpPayload"
                 Text="{Binding ElementName=dgTcp, Path=SelectedItem.Data, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 Padding="5"
                 BorderThickness="0"/>
                                        </GroupBox>
                                    </Grid>

                                    <Grid x:Name="GridHttpView">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbNetworkType}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <DataGrid x:Name="dgHttp"
          Grid.Row="0"
          ItemsSource="{Binding SelectedStageData.NetworkHttpFlows}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          SelectionMode="Extended"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          Background="White"
          RowHeight="25"
          BorderThickness="0">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="❌ Delete Selected Row" Click="BtnDeleteHttpRow_Click"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                                                <DataGridTextColumn Header="Stg" Binding="{Binding Stage}" Width="35" ToolTipService.ToolTip="Stage Index"/>

                                                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="70" FontWeight="Bold" Foreground="#2980B9"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60" FontWeight="Bold"/>
                                                <DataGridTextColumn Header="Ver" Binding="{Binding HttpVersion}" Width="60"/>

                                                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="120"/>
                                                <DataGridTextColumn Header="URI" Binding="{Binding URI}" Width="150">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                            <Setter Property="ToolTip" Value="{Binding URI}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130"/>
                                                <DataGridTextColumn Header="Src Role" Binding="{Binding SourceRole}" Width="70" Foreground="Gray"/>

                                                <DataGridTextColumn Header="Dest" Binding="{Binding Destination}" Width="130"/>
                                                <DataGridTextColumn Header="Dst Role" Binding="{Binding DestinationRole}" Width="70" Foreground="Gray"/>

                                                <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="80" FontWeight="Bold" Foreground="#E67E22"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" Foreground="Gray"/>

                                                <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                            <Setter Property="ToolTip" Value="{Binding Info}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#BDC3C7" ShowsPreview="True"/>

                                        <Grid Grid.Row="2" Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <GroupBox Grid.Column="0" Header="📑 HTTP Headers" BorderBrush="#9B59B6">
                                                <TextBox Text="{Binding ElementName=dgHttp, Path=SelectedItem.HttpHeaders, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="5"
                                 BorderThickness="0"/>
                                            </GroupBox>

                                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#BDC3C7"/>

                                            <GroupBox Grid.Column="2" Header="📄 HTTP Body" BorderBrush="#27AE60">
                                                <TextBox Text="{Binding ElementName=dgHttp, Path=SelectedItem.HttpBody, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="5"
                                 BorderThickness="0"/>
                                            </GroupBox>
                                        </Grid>
                                    </Grid>

                                </Grid>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </GroupBox>
            </Grid>
        </DockPanel>
    </Grid>
</Window>