<Window x:Class="WpfUI.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        mc:Ignorable="d"
        Title="RecorderWindow" Height="700" Width="1200">
    <Grid>
        <DockPanel>

            <!-- ✅ Top Bar: Export + Process Controls -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                <Border Background="#2C3E50" 
                        Padding="10,5" 
                        CornerRadius="3"
                        Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦 Queue: " 
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding PendingTransactionCount}" 
                                   Foreground="#3498DB"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   MinWidth="20"
                                   TextAlignment="Center"/>

                        <!-- ✅ Warning icon -->
                        <TextBlock Text="⚠️" 
                                   Foreground="Yellow"
                                   FontSize="12"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   ToolTip="Press F12 to capture input and flush queue">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingTransactionCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Content="📥 Save Data" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnExportData_Click"
                        Background="#27AE60" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Export all test data to Excel file"/>

                <!-- Separator -->
                <Separator Width="2" Background="LightGray" Margin="10,0"/>

                <!-- ✅ Start/Close Client Buttons -->
                <Button x:Name="BtnStartClient"
                        Content="▶️ Start Client" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnStartClient_Click"
                        Background="#3498DB" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Start the client process"
                        Visibility="Visible"/>

                <Button x:Name="BtnCloseClient"
                        Content="🔴 Close Client" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnCloseClient_Click"
                        Background="#E67E22" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Stop and close the client process"
                        Visibility="Collapsed"/>

                <!-- ✅ Start/Close Server Buttons -->
                <Button x:Name="BtnStartServer"
                        Content="▶️ Start Server" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnStartServer_Click"
                        Background="#9B59B6" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Start the server process"
                        Visibility="Visible"/>

                <Button x:Name="BtnCloseServer"
                        Content="🔴 Close Server" 
                        Width="120" 
                        Margin="5,0,0,0" 
                        Click="BtnCloseServer_Click"
                        Background="#9B59B6" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        ToolTip="Stop and close the server process"
                        Visibility="Collapsed"/>
            </StackPanel>

            <!-- ✅ Stage Selection + Delete Stage Button -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                <Label Content="Select Stage:" Margin="5,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox x:Name="cmbStages"
                          ItemsSource="{Binding StageKeys}"
                          SelectedValue="{Binding SelectedStageKey, Mode=TwoWay}"
                          SelectionChanged="CmbStages_SelectionChanged"
                          Width="200"
                          VerticalAlignment="Center"
                          FontSize="12"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray">
                    <Run Text="Total Stages: "/>
                    <Run Text="{Binding StageKeys.Count, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <!-- ✅ Delete Stage Button -->
                <Button Content="🗑️ Delete Stage" 
                        Width="120" 
                        Margin="20,0,0,0" 
                        Click="BtnDeleteStage_Click"
                        Background="#E74C3C" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="5"
                        VerticalAlignment="Center"
                        ToolTip="Delete the selected stage and all its data"/>
            </StackPanel>

            <!-- ✅ Main Content: Split Top (User - Compact) and Bottom (Outputs - Maximum Space) -->
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <!-- ✅ User Input chỉ chiếm 55px (1 hàng) -->
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="5"/>
                    <!-- ✅ Outputs chiếm toàn bộ không gian còn lại -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============= TOP SECTION: USER INPUT (SINGLE ROW - COMPACT) ============= -->
                <GroupBox Grid.Row="0" Header="👤 User Input">
                    <Grid Margin="5,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- Stage -->
                        <Label Grid.Column="0" Content="Stage:" FontWeight="Bold" VerticalAlignment="Center" Padding="0"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SelectedStageData.User.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="3,0"
                                 VerticalAlignment="Center"
                                 Height="24"/>

                        <!-- Action -->
                        <Label Grid.Column="2" Content="Action:" FontWeight="Bold" VerticalAlignment="Center" Padding="0" Margin="8,0,0,0"/>
                        <TextBox Grid.Column="3" 
                                 Text="{Binding SelectedStageData.User.Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="3,0"
                                 VerticalAlignment="Center"
                                 Height="24"/>

                        <!-- Input -->
                        <Label Grid.Column="4" Content="Input:" FontWeight="Bold" VerticalAlignment="Center" Padding="0" Margin="8,0,0,0"/>
                        <TextBox Grid.Column="5" 
                                 Text="{Binding SelectedStageData.User.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="3,0"
                                 VerticalAlignment="Center"
                                 Height="24"/>

                        <!-- Clear Button -->
                        <Button Grid.Column="6" 
                                Content="🧹" 
                                Click="BtnClearInputClient_Click"
                                Background="#E67E22" 
                                Foreground="White"
                                BorderThickness="0" 
                                Cursor="Hand"
                                Padding="6,2"
                                Margin="3,0"
                                Width="35"
                                Height="24"
                                VerticalAlignment="Center"
                                ToolTip="Clear user input data"/>
                    </Grid>
                </GroupBox>

                <!-- ============= SPLITTER ============= -->
                <GridSplitter Grid.Row="1" 
                              Height="5" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Center"
                              Background="LightGray"
                              ShowsPreview="True"/>

                <!-- ============= BOTTOM SECTION: OUTPUTS (TABS - MAXIMUM SPACE) ============= -->
                <GroupBox Grid.Row="2" Header="📊 Outputs" Margin="0,5,0,0">
                    <TabControl>
                        <!-- Tab 1: Client Output -->
                        <TabItem Header="💻 Client">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                                        <Button Content="🧹 Clear Data" 
                                                Click="BtnClearOutputClient_Click"
                                                Background="#E67E22" 
                                                Foreground="White"
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                Padding="8,4"
                                                ToolTip="Clear client output data for current stage"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Stage -->
                                        <Label Grid.Row="0" Grid.Column="0" Content="Stage:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Client.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"/>

                                        <!-- Console -->
                                        <Label Grid.Row="1" Grid.Column="0" Content="Console:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Client.Console, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"
                                                 MinHeight="350"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Server Output -->
                        <TabItem Header="🖥️ Server">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                                        <Button Content="🧹 Clear Data" 
                                                Click="BtnClearOutputServer_Click"
                                                Background="#E67E22" 
                                                Foreground="White"
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                Padding="8,4"
                                                ToolTip="Clear server output data for current stage"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Stage -->
                                        <Label Grid.Row="0" Grid.Column="0" Content="Stage:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Server.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"/>

                                        <!-- Console -->
                                        <Label Grid.Row="1" Grid.Column="0" Content="Console:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Server.Console, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"
                                                 MinHeight="350"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: Database -->
                        <TabItem Header="🗄️ Database">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                                        <Button Content="🧹 Clear Data" 
                                                Click="BtnClearOutputDB_Click"
                                                Background="#E67E22" 
                                                Foreground="White"
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                Padding="8,4"
                                                ToolTip="Clear database data for current stage"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Stage -->
                                        <Label Grid.Row="0" Grid.Column="0" Content="Stage:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Database.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"/>

                                        <!-- Query -->
                                        <Label Grid.Row="1" Grid.Column="0" Content="Query:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Database.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"
                                                 MinHeight="140"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"/>

                                        <!-- Expected Data -->
                                        <Label Grid.Row="2" Grid.Column="0" Content="Expected Data:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" 
                                                 Text="{Binding SelectedStageData.Database.ExpectedData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="5"
                                                 MinHeight="230"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 4: Network -->
                        <!-- Tab 4: Network -->
                        <TabItem Header="🌐 Network">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                                        <Button Content="🧹 Clear Data" 
                        Click="BtnClearNetwork_Click"
                        Background="#E67E22" 
                        Foreground="White"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Padding="8,4"
                        ToolTip="Clear network data for current stage"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Stage -->
                                        <Label Grid.Row="0" Grid.Column="0" Content="Stage:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                         Text="{Binding SelectedStageData.Network.Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5"/>

                                        <!-- URL -->
                                        <Label Grid.Row="1" Grid.Column="0" Content="URL:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                         Text="{Binding SelectedStageData.Network.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5"/>

                                        <!-- HttpMethod -->
                                        <Label Grid.Row="2" Grid.Column="0" Content="HTTP Method:" FontWeight="Bold" Margin="5"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" 
                         Text="{Binding SelectedStageData.Network.HttpMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5"
                         ToolTip="HTTP Method (GET, POST, PUT, DELETE, etc.)"/>

                                        <!-- Request Payload -->
                                        <Label Grid.Row="3" Grid.Column="0" Content="REQ Payload:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" 
                         Text="{Binding SelectedStageData.Network.REQ_Payload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5"
                         MinHeight="200"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Disabled"/>

                                        <!-- Response Payload -->
                                        <Label Grid.Row="4" Grid.Column="0" Content="RES Payload:" FontWeight="Bold" Margin="5" VerticalAlignment="Top"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" 
                         Text="{Binding SelectedStageData.Network.RES_Payload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5"
                         MinHeight="200"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Disabled"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </GroupBox>
            </Grid>
        </DockPanel>
    </Grid>
</Window>