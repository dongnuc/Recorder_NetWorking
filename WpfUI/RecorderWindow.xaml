<Window x:Class="WpfUI.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        mc:Ignorable="d"
        Title="RecorderWindow" Height="450" Width="800">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Content="📥 Export Data" 
                    Width="120" 
                    Margin="5,0,0,0" 
                    Click="BtnExportData_Click"
                    Background="#27AE60" 
                    Foreground="White"
                    BorderThickness="0" 
                    Cursor="Hand"
                    Padding="5"
                    ToolTip="Export all test data to JSON file"/>

            <Button Content="🗑️ Delete Stage" 
                    Width="120" 
                    Margin="5,0,0,0" 
                    Click="BtnDeleteStage_Click"
                    Background="#E74C3C" 
                    Foreground="White"
                    BorderThickness="0" 
                    Cursor="Hand"
                    Padding="5"
                    ToolTip="Delete the selected stage and all its data"/>

            <!-- Separator -->
            <Separator Width="2" Background="LightGray" Margin="10,0"/>

            <!-- Close Client Button -->
            <Button Content="🔴 Close Client" 
                    Width="120" 
                    Margin="5,0,0,0" 
                    Click="BtnCloseClient_Click"
                    Background="#E67E22" 
                    Foreground="White"
                    BorderThickness="0" 
                    Cursor="Hand"
                    Padding="5"
                    ToolTip="Stop and close the client process"/>

            <!-- Close Server Button -->
            <Button Content="🔴 Close Server" 
                    Width="120" 
                    Margin="5,0,0,0" 
                    Click="BtnCloseServer_Click"
                    Background="#9B59B6" 
                    Foreground="White"
                    BorderThickness="0" 
                    Cursor="Hand"
                    Padding="5"
                    ToolTip="Stop and close the server process"/>
        </StackPanel>

        <!-- Stage Selection ComboBox -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Label Content="Select Stage:" Margin="5,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
            <ComboBox x:Name="cmbStages"
                  ItemsSource="{Binding StageKeys}"
                  SelectedValue="{Binding SelectedStageKey, Mode=TwoWay}"
                  SelectionChanged="CmbStages_SelectionChanged"
                  Width="200"
                  VerticalAlignment="Center"
                  FontSize="12"/>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray">
                <Run Text="Total Stages: "/>
                <Run Text="{Binding StageKeys.Count, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>
        </StackPanel>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Input Client" Margin="0,0,0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                        <Button Content="🗑️ Delete Selected" 
                                Click="BtnDeleteInputClient_Click"
                                Background="#E67E22" 
                                Foreground="White"
                                BorderThickness="0" 
                                Cursor="Hand"
                                Padding="8,4"
                                ToolTip="Delete selected input client row"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="dgInputClients"
                              ItemsSource="{Binding SelectedStageData.InputClients, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stage" 
                                                Binding="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="70" 
                                                IsReadOnly="False"/>
                            <DataGridTextColumn Header="Action" 
                                                Binding="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="120" 
                                                IsReadOnly="False"/>
                            <DataGridTextColumn Header="Input" 
                                                Binding="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="*" 
                                                IsReadOnly="False"/>
                            <DataGridTextColumn Header="DataType" 
                                                Binding="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="150" 
                                                IsReadOnly="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Row="1" 
                          Height="5" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Center"
                          Background="LightGray"
                          ShowsPreview="True"/>

            <GroupBox Grid.Row="2" Header="Outputs" Margin="0,5,0,0">
                <TabControl>
                    <TabItem Header="Output Client">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                                <Button Content="🗑️ Delete Selected" 
                                        Click="BtnDeleteOutputClient_Click"
                                        Background="#E67E22" 
                                        Foreground="White"
                                        BorderThickness="0" 
                                        Cursor="Hand"
                                        Padding="8,4"
                                        ToolTip="Delete selected output client row"/>
                            </StackPanel>

