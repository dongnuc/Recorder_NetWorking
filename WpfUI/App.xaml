             xmlns:local="clr-namespace:WpfUI"
             xmlns:converters="clr-namespace:WpfUI.Converters"
             StartupUri="MainWindow.xaml"
             >

    <Application.Resources>
        <ResourceDictionary>
            <converters:FolderToIconConverter x:Key="FolderToIconConverter" />
        </ResourceDictionary>
    </Application.Resources>
