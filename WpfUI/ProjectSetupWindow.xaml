<Window x:Class="WpfUI.ProjectSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UITestKit - Project Setup" 
        Height="850" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🎙️ Test Case Project Setup" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <GroupBox Grid.Row="1" Header="Project Name" Margin="0,0,0,10">
            <TextBox x:Name="TxtProjectName" Height="30" VerticalContentAlignment="Center" Text="MyNewTestKit"/>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Project Location" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtProjectLocation" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" Text="D:\MyTestCases"/>
                <Button Grid.Column="1" Content="📁 Browse Folder" Width="120" Height="30" Click="BtnBrowseFolder_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Client Executable" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtClientPath" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Content="📁 Browse" Width="100" Height="30" Click="BtnBrowseClient_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Server Executable" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtServerPath" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Content="📁 Browse" Width="100" Height="30" Click="BtnBrowseServer_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="5" Header="Protocol" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbHttp" Content="🌐 HTTP" IsChecked="True" Margin="10,0,20,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbTcp" Content="🔌 TCP" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="6" Header="Use Database" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbDbYes" 
                             Content="Yes" 
                             IsChecked="True"
                             Margin="10,0,20,0"
                             VerticalAlignment="Center"/>
                <RadioButton x:Name="RbDbNo" 
                             Content="No"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="7" Background="#34495E" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock x:Name="TxtStatus" Text="Ready to setup project" Foreground="White" FontWeight="Bold"/>
        </Border>

        <Button Grid.Row="8"
                x:Name="BtnCreateProject"
                Content="Create Project"
                Height="50" FontSize="16" FontWeight="Bold"
                Background="#27AE60" Foreground="White"
                Click="BtnCreateProject_Click" 
                VerticalAlignment="Top"/>
    </Grid>
</Window>